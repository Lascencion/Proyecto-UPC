<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TOBE" name="Proceso propuesto (TO-BE)" targetNamespace="http://upc.edu.pe/qa-knowledge/bpmn" exporter="generar_bpmn.py" exporterVersion="1.0">
  <collaboration id="Collaboration_TOBE">
    <participant id="Participant_TOBE" name="Proceso propuesto (TO-BE): generación de casos de prueba funcionales con LLM" processRef="Process_TOBE" />
  </collaboration>
  <process id="Process_TOBE" name="Proceso propuesto (TO-BE): generación de casos de prueba funcionales con LLM" isExecutable="false">
    <laneSet id="LaneSet_TOBE">
      <lane id="Lane_TOBE_Analista" name="Analista QA">
        <flowNodeRef>Start_TOBE</flowNodeRef>
        <flowNodeRef>Task_TOBE_Login</flowNodeRef>
        <flowNodeRef>Task_TOBE_Registrar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Ingresar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Revisar</flowNodeRef>
        <flowNodeRef>Gw_TOBE_Correctos</flowNodeRef>
        <flowNodeRef>Task_TOBE_Enviar</flowNodeRef>
      </lane>
      <lane id="Lane_TOBE_Sistema" name="Sistema (LLM)">
        <flowNodeRef>Task_TOBE_Validar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Almacenar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Recuperar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Generar</flowNodeRef>
        <flowNodeRef>Task_TOBE_Reportes</flowNodeRef>
        <flowNodeRef>End_TOBE</flowNodeRef>
      </lane>
      <lane id="Lane_TOBE_Lider" name="Líder QA">
        <flowNodeRef>Task_TOBE_RevisarLider</flowNodeRef>
        <flowNodeRef>Gw_TOBE_Aprueba</flowNodeRef>
        <flowNodeRef>Task_TOBE_Devolver</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_TOBE" name="Inicio">
      <outgoing>Flow_TOBE_1</outgoing>
    </startEvent>
    <userTask id="Task_TOBE_Login" name="Iniciar sesión">
      <incoming>Flow_TOBE_1</incoming>
      <outgoing>Flow_TOBE_2</outgoing>
    </userTask>
    <serviceTask id="Task_TOBE_Validar" name="Validar credenciales y mostrar el menú según el rol">
      <incoming>Flow_TOBE_2</incoming>
      <outgoing>Flow_TOBE_3</outgoing>
    </serviceTask>
    <userTask id="Task_TOBE_Registrar" name="Registrar información histórica (individual o masiva)">
      <documentation>Requerimientos, reglas de negocio, casos de prueba y defectos, por formulario o carga masiva (Excel, Word, CSV).</documentation>
      <incoming>Flow_TOBE_3</incoming>
      <outgoing>Flow_TOBE_4</outgoing>
    </userTask>
    <serviceTask id="Task_TOBE_Almacenar" name="Validar y almacenar en la base de conocimiento">
      <incoming>Flow_TOBE_4</incoming>
      <outgoing>Flow_TOBE_5</outgoing>
    </serviceTask>
    <userTask id="Task_TOBE_Ingresar" name="Ingresar el requerimiento a validar">
      <incoming>Flow_TOBE_5</incoming>
      <outgoing>Flow_TOBE_6</outgoing>
    </userTask>
    <serviceTask id="Task_TOBE_Recuperar" name="Recuperar reglas, requerimientos y casos históricos similares">
      <incoming>Flow_TOBE_6</incoming>
      <outgoing>Flow_TOBE_7</outgoing>
    </serviceTask>
    <serviceTask id="Task_TOBE_Generar" name="Generar los casos de prueba funcionales (LLM)">
      <incoming>Flow_TOBE_7</incoming>
      <incoming>Flow_TOBE_10</incoming>
      <outgoing>Flow_TOBE_8</outgoing>
    </serviceTask>
    <userTask id="Task_TOBE_Revisar" name="Revisar los casos generados">
      <incoming>Flow_TOBE_8</incoming>
      <incoming>Flow_TOBE_17</incoming>
      <outgoing>Flow_TOBE_9</outgoing>
    </userTask>
    <exclusiveGateway id="Gw_TOBE_Correctos" name="¿Son correctos?">
      <incoming>Flow_TOBE_9</incoming>
      <outgoing>Flow_TOBE_10</outgoing>
      <outgoing>Flow_TOBE_11</outgoing>
    </exclusiveGateway>
    <userTask id="Task_TOBE_Enviar" name="Enviar los casos a aprobación">
      <incoming>Flow_TOBE_11</incoming>
      <outgoing>Flow_TOBE_12</outgoing>
    </userTask>
    <userTask id="Task_TOBE_RevisarLider" name="Revisar los casos de prueba">
      <incoming>Flow_TOBE_12</incoming>
      <outgoing>Flow_TOBE_13</outgoing>
    </userTask>
    <exclusiveGateway id="Gw_TOBE_Aprueba" name="¿Aprueba?">
      <incoming>Flow_TOBE_13</incoming>
      <outgoing>Flow_TOBE_14</outgoing>
      <outgoing>Flow_TOBE_15</outgoing>
    </exclusiveGateway>
    <userTask id="Task_TOBE_Devolver" name="Devolver con observaciones">
      <incoming>Flow_TOBE_15</incoming>
      <outgoing>Flow_TOBE_17</outgoing>
    </userTask>
    <serviceTask id="Task_TOBE_Reportes" name="Registrar los casos aprobados y generar reportes">
      <incoming>Flow_TOBE_14</incoming>
      <outgoing>Flow_TOBE_16</outgoing>
    </serviceTask>
    <endEvent id="End_TOBE" name="Casos de prueba aprobados">
      <incoming>Flow_TOBE_16</incoming>
    </endEvent>
    <sequenceFlow id="Flow_TOBE_1" sourceRef="Start_TOBE" targetRef="Task_TOBE_Login" />
    <sequenceFlow id="Flow_TOBE_2" sourceRef="Task_TOBE_Login" targetRef="Task_TOBE_Validar" />
    <sequenceFlow id="Flow_TOBE_3" sourceRef="Task_TOBE_Validar" targetRef="Task_TOBE_Registrar" />
    <sequenceFlow id="Flow_TOBE_4" sourceRef="Task_TOBE_Registrar" targetRef="Task_TOBE_Almacenar" />
    <sequenceFlow id="Flow_TOBE_5" sourceRef="Task_TOBE_Almacenar" targetRef="Task_TOBE_Ingresar" />
    <sequenceFlow id="Flow_TOBE_6" sourceRef="Task_TOBE_Ingresar" targetRef="Task_TOBE_Recuperar" />
    <sequenceFlow id="Flow_TOBE_7" sourceRef="Task_TOBE_Recuperar" targetRef="Task_TOBE_Generar" />
    <sequenceFlow id="Flow_TOBE_8" sourceRef="Task_TOBE_Generar" targetRef="Task_TOBE_Revisar" />
    <sequenceFlow id="Flow_TOBE_9" sourceRef="Task_TOBE_Revisar" targetRef="Gw_TOBE_Correctos" />
    <sequenceFlow id="Flow_TOBE_10" name="No: solicita nueva generación" sourceRef="Gw_TOBE_Correctos" targetRef="Task_TOBE_Generar" />
    <sequenceFlow id="Flow_TOBE_11" name="Sí" sourceRef="Gw_TOBE_Correctos" targetRef="Task_TOBE_Enviar" />
    <sequenceFlow id="Flow_TOBE_12" sourceRef="Task_TOBE_Enviar" targetRef="Task_TOBE_RevisarLider" />
    <sequenceFlow id="Flow_TOBE_13" sourceRef="Task_TOBE_RevisarLider" targetRef="Gw_TOBE_Aprueba" />
    <sequenceFlow id="Flow_TOBE_14" name="Sí" sourceRef="Gw_TOBE_Aprueba" targetRef="Task_TOBE_Reportes" />
    <sequenceFlow id="Flow_TOBE_15" name="No" sourceRef="Gw_TOBE_Aprueba" targetRef="Task_TOBE_Devolver" />
    <sequenceFlow id="Flow_TOBE_16" sourceRef="Task_TOBE_Reportes" targetRef="End_TOBE" />
    <sequenceFlow id="Flow_TOBE_17" name="El Analista QA ajusta y vuelve a revisar" sourceRef="Task_TOBE_Devolver" targetRef="Task_TOBE_Revisar" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_TOBE" name="Proceso propuesto (TO-BE)">
    <bpmndi:BPMNPlane id="Plane_TOBE" bpmnElement="Collaboration_TOBE">
      <bpmndi:BPMNShape id="Participant_TOBE_di" bpmnElement="Participant_TOBE" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="2530" height="510" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TOBE_Analista_di" bpmnElement="Lane_TOBE_Analista" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="2500" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TOBE_Sistema_di" bpmnElement="Lane_TOBE_Sistema" isHorizontal="true">
        <dc:Bounds x="70" y="210" width="2500" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TOBE_Lider_di" bpmnElement="Lane_TOBE_Lider" isHorizontal="true">
        <dc:Bounds x="70" y="380" width="2500" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_TOBE_di" bpmnElement="Start_TOBE">
        <dc:Bounds x="174" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="148" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Login_di" bpmnElement="Task_TOBE_Login">
        <dc:Bounds x="295" y="90" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Validar_di" bpmnElement="Task_TOBE_Validar">
        <dc:Bounds x="460" y="260" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Registrar_di" bpmnElement="Task_TOBE_Registrar">
        <dc:Bounds x="625" y="90" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Almacenar_di" bpmnElement="Task_TOBE_Almacenar">
        <dc:Bounds x="790" y="260" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Ingresar_di" bpmnElement="Task_TOBE_Ingresar">
