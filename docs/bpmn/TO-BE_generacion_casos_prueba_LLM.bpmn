      <bpmndi:BPMNShape id="Task_TOBE_Recuperar_di" bpmnElement="Task_TOBE_Recuperar">
        <dc:Bounds x="1120" y="260" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Generar_di" bpmnElement="Task_TOBE_Generar">
        <dc:Bounds x="1285" y="260" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Revisar_di" bpmnElement="Task_TOBE_Revisar">
        <dc:Bounds x="1450" y="90" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TOBE_Correctos_di" bpmnElement="Gw_TOBE_Correctos" isMarkerVisible="true">
        <dc:Bounds x="1652" y="100" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1622" y="155" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Enviar_di" bpmnElement="Task_TOBE_Enviar">
        <dc:Bounds x="1780" y="90" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_RevisarLider_di" bpmnElement="Task_TOBE_RevisarLider">
        <dc:Bounds x="1945" y="430" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_TOBE_Aprueba_di" bpmnElement="Gw_TOBE_Aprueba" isMarkerVisible="true">
        <dc:Bounds x="2148" y="440" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="2118" y="495" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Devolver_di" bpmnElement="Task_TOBE_Devolver">
        <dc:Bounds x="2275" y="430" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TOBE_Reportes_di" bpmnElement="Task_TOBE_Reportes">
        <dc:Bounds x="2275" y="260" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TOBE_di" bpmnElement="End_TOBE">
        <dc:Bounds x="2484" y="277" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2448" y="318" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TOBE_1_di" bpmnElement="Flow_TOBE_1">
        <di:waypoint x="210" y="125" />
        <di:waypoint x="295" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_2_di" bpmnElement="Flow_TOBE_2">
        <di:waypoint x="420" y="125" />
        <di:waypoint x="440" y="125" />
        <di:waypoint x="440" y="295" />
        <di:waypoint x="460" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_3_di" bpmnElement="Flow_TOBE_3">
        <di:waypoint x="585" y="295" />
        <di:waypoint x="605" y="295" />
        <di:waypoint x="605" y="125" />
        <di:waypoint x="625" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_4_di" bpmnElement="Flow_TOBE_4">
        <di:waypoint x="750" y="125" />
        <di:waypoint x="770" y="125" />
        <di:waypoint x="770" y="295" />
        <di:waypoint x="790" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_5_di" bpmnElement="Flow_TOBE_5">
        <di:waypoint x="915" y="295" />
        <di:waypoint x="935" y="295" />
        <di:waypoint x="935" y="125" />
        <di:waypoint x="955" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_6_di" bpmnElement="Flow_TOBE_6">
        <di:waypoint x="1080" y="125" />
        <di:waypoint x="1100" y="125" />
        <di:waypoint x="1100" y="295" />
        <di:waypoint x="1120" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_7_di" bpmnElement="Flow_TOBE_7">
        <di:waypoint x="1245" y="295" />
        <di:waypoint x="1285" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_8_di" bpmnElement="Flow_TOBE_8">
        <di:waypoint x="1348" y="260" />
        <di:waypoint x="1348" y="125" />
        <di:waypoint x="1450" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_9_di" bpmnElement="Flow_TOBE_9">
        <di:waypoint x="1575" y="125" />
        <di:waypoint x="1652" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_10_di" bpmnElement="Flow_TOBE_10">
        <di:waypoint x="1678" y="150" />
