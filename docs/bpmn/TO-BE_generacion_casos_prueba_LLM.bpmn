        <di:waypoint x="1410" y="295" />
        <bpmndi:BPMNLabel><dc:Bounds x="1686" y="190" width="170" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_11_di" bpmnElement="Flow_TOBE_11">
        <di:waypoint x="1702" y="125" />
        <di:waypoint x="1780" y="125" />
        <bpmndi:BPMNLabel><dc:Bounds x="1710" y="103" width="120" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TOBE_12_di" bpmnElement="Flow_TOBE_12">
        <di:waypoint x="1905" y="125" />
        <di:waypoint x="1925" y="125" />
        <di:waypoint x="1925" y="465" />
        <di:waypoint x="1945" y="465" />
      </bpmndi:BPMNEdge>
