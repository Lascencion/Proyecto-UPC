# Puerto de la API
PORT=3000
# Cadena de conexión a MongoDB (local). Para la nube (MongoDB Atlas) basta con reemplazarla.
MONGODB_URI=mongodb://localhost:27017/qa_knowledge
# Secreto para firmar los tokens JWT (cámbielo en producción)
JWT_SECRET=cambiar-este-secreto
JWT_EXPIRES_IN=8h
# Usuario administrador creado automáticamente si no existe ninguno
ADMIN_EMAIL=admin@qa.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:4200
# Generación de casos de prueba con LLM
# LLM_PROVIDER: claude | simulado. Si se omite, usa Claude cuando hay ANTHROPIC_API_KEY; si no, el modo simulado.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento del modelo: low | medium | high | xhigh | max
LLM_EFFORT=medium
